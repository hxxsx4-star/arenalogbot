[Unit]
Description=Arena Auction Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hxxsx4
WorkingDirectory=/home/hxxsx4/arena/arenamatchbot
EnvironmentFile=/etc/arena/auctionweb.env
ExecStart=/usr/bin/python3 -m uvicorn web.server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
